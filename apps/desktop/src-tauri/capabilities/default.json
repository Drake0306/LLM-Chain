{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and any spawned multi-window views (F-D17)",
  "windows": ["main", "extra-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/llm-chain-sidecar", "sidecar": true }]
    }
  ]
}
